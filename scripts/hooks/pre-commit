#!/bin/sh
# Pre-commit hook: Scan for potential secrets
# Install: cp scripts/hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
#
# Scans only ADDED lines — a commit that REMOVES a secret-shaped string
# (e.g. cleaning up an old placeholder) must not be blocked.

echo "🔒 Scanning for secrets..."

# Check staged files (skip this hook file and docs)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -v -E "^(scripts/hooks/pre-commit|SECURITY\.md)$")

if [ -z "$STAGED_FILES" ]; then
  exit 0
fi

# Added lines only (leading '+', excluding the '+++' file headers)
ADDED_LINES=$(git diff --cached --diff-filter=ACM | grep -E "^\+" | grep -v -E "^\+\+\+")

if [ -z "$ADDED_LINES" ]; then
  echo "✅ No secrets detected."
  exit 0
fi

# Patterns to block
FOUND=0

# Stripe webhook secrets
MATCHES=$(echo "$ADDED_LINES" | grep -E "whsec_[a-zA-Z0-9]" | head -20)
if [ -n "$MATCHES" ]; then
  echo ""
  echo "❌ BLOCKED: Potential Stripe webhook secret detected"
  echo "$MATCHES"
  FOUND=1
fi

# Stripe secret keys
MATCHES=$(echo "$ADDED_LINES" | grep -E "sk_live_[a-zA-Z0-9]" | head -20)
if [ -n "$MATCHES" ]; then
  echo ""
  echo "❌ BLOCKED: Potential Stripe live secret key detected"
  echo "$MATCHES"
  FOUND=1
fi

# Stripe test keys (real ones are long; placeholders like sk_test_... are fine)
MATCHES=$(echo "$ADDED_LINES" | grep -E "sk_test_[a-zA-Z0-9]{16,}" | head -20)
if [ -n "$MATCHES" ]; then
  echo ""
  echo "❌ BLOCKED: Potential Stripe test secret key detected"
  echo "$MATCHES"
  FOUND=1
fi

# AWS keys
MATCHES=$(echo "$ADDED_LINES" | grep -E "AKIA[0-9A-Z]{16}" | head -20)
if [ -n "$MATCHES" ]; then
  echo ""
  echo "❌ BLOCKED: Potential AWS access key detected"
  echo "$MATCHES"
  FOUND=1
fi

# GitHub tokens
MATCHES=$(echo "$ADDED_LINES" | grep -E "ghp_[a-zA-Z0-9]{20,}" | head -20)
if [ -n "$MATCHES" ]; then
  echo ""
  echo "❌ BLOCKED: Potential GitHub token detected"
  echo "$MATCHES"
  FOUND=1
fi

# Private keys
MATCHES=$(echo "$ADDED_LINES" | grep -E "BEGIN [A-Z ]*PRIVATE KEY" | head -20)
if [ -n "$MATCHES" ]; then
  echo ""
  echo "❌ BLOCKED: Potential private key detected"
  echo "$MATCHES"
  FOUND=1
fi

if [ "$FOUND" -eq 1 ]; then
  echo ""
  echo "🚨 Commit blocked. Secrets must not be committed to git."
  echo "If this is a false positive: git commit --no-verify"
  echo ""
  exit 1
fi

echo "✅ No secrets detected."
exit 0
