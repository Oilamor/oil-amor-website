# =============================================================================
# OIL AMOR — Environment Configuration (canonical reference)
# =============================================================================
# Copy this file to .env.local and fill in real values.
# .env.local.example is an identical copy of this file.
# Every variable listed here is actually read by the codebase (verified by
# grepping `process.env.*` across app/, lib/, scripts/, and config files).
# DO NOT commit .env.local to version control.
# =============================================================================

# =============================================================================
# APP URLS
# =============================================================================
# Primary public URL of the site. Three names exist for historical reasons;
# set all three to the same value. Code falls back to https://oilamor.com.
# - NEXT_PUBLIC_APP_URL: t3-env schema, Stripe redirect URLs
# - NEXT_PUBLIC_SITE_URL: SEO metadata, checkout origin allowlist, share links
# - NEXT_PUBLIC_URL: email template links (lib/email/*)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_URL=http://localhost:3000

# Playwright E2E base URL (tests run against a local dev server when unset)
# BASE_URL=http://localhost:3000

# =============================================================================
# DATABASE (Neon PostgreSQL)
# =============================================================================
DATABASE_URL=postgresql://user:password@localhost:5432/oilamor

# Discrete connection params — only used by seed scripts (scripts/seed-*.ts)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=oilamor
# DB_USER=postgres
# DB_PASSWORD=

# Guards for the /api/db/setup and /api/db/migrate endpoints (both required)
ALLOW_DDL_ENDPOINTS=false
DB_SETUP_KEY=

# =============================================================================
# REDIS (Upstash REST — the single Redis client for the whole app)
# =============================================================================
# Used by: rate limiting, cart, content cache, rewards system.
# REST is the right model for Vercel serverless (no persistent TCP socket).
# Get these from console.upstash.io -> your database -> REST API.
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# =============================================================================
# SANITY CMS
# =============================================================================
# Public (exposed to the browser)
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
# Server-side (used by lib/ scripts and API routes)
SANITY_PROJECT_ID=your-project-id
SANITY_DATASET=production
# API token with read + write permissions (sanity.io/manage > API > Tokens)
SANITY_API_TOKEN=
# Alias read only by scripts/seed-synergy-content.ts — set to the same token
# SANITY_TOKEN=

# =============================================================================
# STRIPE
# =============================================================================
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
# Price IDs for shipping rates (create in the Stripe Dashboard)
STRIPE_SHIPPING_STANDARD_PRICE_ID=price_...
STRIPE_SHIPPING_EXPRESS_PRICE_ID=price_...

# =============================================================================
# AUSTRALIA POST (shipping quotes, labels, webhooks)
# =============================================================================
AUSPOST_API_KEY=
AUSPOST_API_SECRET=
# Optional: override the API base URL (defaults to the AusPost production API)
# AUSPOST_API_BASE=https://digitalapi.auspost.com.au
# Optional: account number for negotiated rates
# AUSPOST_ACCOUNT_NUMBER=
# Secret for verifying AusPost tracking webhooks
AUSPOST_WEBHOOK_SECRET=

# =============================================================================
# EMAIL (Resend)
# =============================================================================
RESEND_API_KEY=re_...
# Domain used to build the From address (noreply@<domain>)
EMAIL_FROM_DOMAIN=oilamor.com
# Inbox that receives order alerts and contact-form submissions
ADMIN_EMAIL=official.oilamor@gmail.com

# =============================================================================
# ADMIN / AUTH
# =============================================================================
# Bearer token for machine-to-machine admin API access
ADMIN_API_KEY=
# bcrypt hash for human admin login (preferred over ADMIN_API_KEY)
# ADMIN_PASSWORD_HASH=
# iron-session cookie encryption password (min 32 chars; openssl rand -base64 32)
IRON_SESSION_PASSWORD=
# Optional separate session password override
# ADMIN_SESSION_PASSWORD=

# =============================================================================
# SENTRY (error tracking — optional; all disabled when unset)
# =============================================================================
# Client-side DSN (read by instrumentation-client.ts)
NEXT_PUBLIC_SENTRY_DSN=
# Server/edge DSN
SENTRY_DSN=
# Enable flags ("true"/"false")
SENTRY_ENABLED=false
NEXT_PUBLIC_SENTRY_ENABLED=false
# Environment + release tagging
SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
# SENTRY_RELEASE=
# NEXT_PUBLIC_SENTRY_RELEASE=
# Sample rates (0.0–1.0)
SENTRY_TRACES_SAMPLE_RATE=1.0
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILES_SAMPLE_RATE=1.0
NEXT_PUBLIC_SENTRY_PROFILES_SAMPLE_RATE=1.0
# Build-time source-map upload (sentry webpack plugin in next.config.js)
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
# CSP violation report endpoint
# SENTRY_CSP_REPORT_URI=

# =============================================================================
# SEO
# =============================================================================
# Google Search Console verification token (lib/seo/metadata.ts)
# NEXT_PUBLIC_GOOGLE_VERIFICATION=

# =============================================================================
# SHIPPING LABEL PDFs (puppeteer)
# =============================================================================
# Path to a system Chrome/Chromium binary; @sparticuz/chromium is used on
# serverless when this is unset
# PUPPETEER_EXECUTABLE_PATH=

# =============================================================================
# DEVELOPMENT / CI ESCAPE HATCH
# =============================================================================
# Skip t3-env validation (env.ts). Never enable in production.
SKIP_ENV_VALIDATION=false
